# ---- Copy to .env and fill in. Never commit .env. ----

# Server
PORT=8080
APP_URL=http://localhost:8080
NODE_ENV=development            # set to "production" when deployed (enables Secure cookies + HTTPS redirect)
DB_PATH=./crucible.db           # point at a mounted volume in production, e.g. /data/crucible.db
# Optional: Postgres connection string (postgres://user:pass@host:5432/db). If unset, SQLite (DB_PATH) is used.
DATABASE_URL=

# Auth (REQUIRED). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
REQUIRE_EMAIL_VERIFICATION=false   # set true to require a confirmed email before running

# Anthropic (REQUIRED). Key lives ONLY here — never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL_FREE=claude-haiku-4-5     # cheaper model for the ad-supported free tier
ANTHROPIC_MODEL_PAID=claude-sonnet-4-6    # better model for paying users

# Economic guardrails (fair-use monthly TOKEN ceilings on "unlimited" plans; 0 = off)
PRO_MONTHLY_TOKEN_CAP=2000000
TEAM_MONTHLY_TOKEN_CAP=6000000

# Email (for verification + password reset). If unset, links print to the server console (dev only).
RESEND_API_KEY=
MAIL_FROM=Crucible <noreply@yourdomain.com>

# Stripe (REQUIRED for paid plans; free tier works without it). Use test keys until live.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxx
STRIPE_PRICE_TEAM=price_xxxxxxxxxxxxx

# Ads (free tier only). Enable AFTER the site is live with policy pages and you're approved.
ADS_ENABLED=false
AD_NETWORK=adsense              # adsense | medianet | custom
AD_CLIENT_ID=                   # e.g. AdSense: ca-pub-xxxxxxxxxxxxxxxx
AD_SLOT_RESULTS=                # the ad unit / slot id
ADS_REQUIRE_CONSENT=true        # gate ads behind consent (required for EEA/UK personalized ads)

# ---- v2.1 additions ----
# Admin dashboard access (/admin). Comma-separated emails that may view cost stats.
ADMIN_EMAILS=you@yourdomain.com

# Redis (optional, for rate-limiting across multiple instances). If set, ALSO run:
#   npm install ioredis rate-limit-redis
# Leave blank to use the built-in single-node memory limiter.
REDIS_URL=

# CSP: keep false for strict nonce-based script policy (recommended).
# Set true ONLY if your ad network requires inline scripts and breaks under nonces.
CSP_ALLOW_INLINE=false
